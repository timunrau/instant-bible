{"format":1,"book":"jol","name":"Joel","chapters":[{"book":"jol","number":1,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Invasion of Locusts"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"jol.1.1","number":1,"nodes":[{"kind":"text","text":"This is the word of the LORD that came to Joel son of Pethuel:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.2","number":2,"nodes":[{"kind":"text","text":"Hear this, O elders;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.2","nodes":[{"kind":"text","text":"and give ear, all who dwell in the land."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.2","nodes":[{"kind":"text","text":"Has anything like this ever happened in your days"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.2","nodes":[{"kind":"text","text":"or in the days of your fathers?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.3","number":3,"nodes":[{"kind":"text","text":"Tell it to your children;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.3","nodes":[{"kind":"text","text":"let your children tell it to their children,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.3","nodes":[{"kind":"text","text":"and their children to the next generation."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.4","number":4,"nodes":[{"kind":"text","text":"What the devouring locust has left,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.4","nodes":[{"kind":"text","text":"the swarming locust has eaten;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.4","nodes":[{"kind":"text","text":"what the swarming locust has left,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.4","nodes":[{"kind":"text","text":"the young locust has eaten;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.4","nodes":[{"kind":"text","text":"and what the young locust has left,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.4","nodes":[{"kind":"text","text":"the destroying locust has eaten."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:4 "},{"kind":"text","text":"The precise identification of the four kinds of locusts mentioned here is uncertain."}]}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.5","number":5,"nodes":[{"kind":"text","text":"Wake up, you drunkards, and weep;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.5","nodes":[{"kind":"text","text":"wail, all you drinkers of wine,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.5","nodes":[{"kind":"text","text":"because of the sweet wine,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.5","nodes":[{"kind":"text","text":"for it has been cut off from your mouth."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.6","number":6,"nodes":[{"kind":"text","text":"For a nation has invaded My land,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.6","nodes":[{"kind":"text","text":"powerful and without number;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.6","nodes":[{"kind":"text","text":"its teeth are the teeth of a lion,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.6","nodes":[{"kind":"text","text":"and its fangs are the fangs of a lioness."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.7","number":7,"nodes":[{"kind":"text","text":"It has laid waste My grapevine"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.7","nodes":[{"kind":"text","text":"and splintered My fig tree."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.7","nodes":[{"kind":"text","text":"It has stripped off the bark and thrown it away;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.7","nodes":[{"kind":"text","text":"the branches have turned white."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"A Call to Mourning"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.8","number":8,"nodes":[{"kind":"text","text":"Wail like a virgin dressed in sackcloth,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.8","nodes":[{"kind":"text","text":"grieving for the husband of her youth."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.9","number":9,"nodes":[{"kind":"text","text":"Grain and drink offerings have been cut off"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.9","nodes":[{"kind":"text","text":"from the house of the LORD;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.9","nodes":[{"kind":"text","text":"the priests are in mourning,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.9","nodes":[{"kind":"text","text":"those who minister before the LORD."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.10","number":10,"nodes":[{"kind":"text","text":"The field is ruined;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.10","nodes":[{"kind":"text","text":"the land mourns."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.10","nodes":[{"kind":"text","text":"For the grain is destroyed,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.10","nodes":[{"kind":"text","text":"the new wine is dried up, and the oil fails."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.11","number":11,"nodes":[{"kind":"text","text":"Be dismayed, O farmers,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.11","nodes":[{"kind":"text","text":"wail, O vinedressers,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.11","nodes":[{"kind":"text","text":"over the wheat and barley,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.11","nodes":[{"kind":"text","text":"because the harvest of the field has perished."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.12","number":12,"nodes":[{"kind":"text","text":"The grapevine is dried up,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.12","nodes":[{"kind":"text","text":"and the fig tree is withered;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.12","nodes":[{"kind":"text","text":"the pomegranate, palm, and apple—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.12","nodes":[{"kind":"text","text":"all the trees of the orchard— are withered."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.12","nodes":[{"kind":"text","text":"Surely the joy of mankind has dried up."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"A Call to Repentance"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.13","number":13,"nodes":[{"kind":"text","text":"Put on sackcloth and lament, O priests;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.13","nodes":[{"kind":"text","text":"wail, O ministers of the altar."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.13","nodes":[{"kind":"text","text":"Come, spend the night in sackcloth,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.13","nodes":[{"kind":"text","text":"O ministers of my God,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.13","nodes":[{"kind":"text","text":"because the grain and drink offerings"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.13","nodes":[{"kind":"text","text":"are withheld from the house of your God."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.14","number":14,"nodes":[{"kind":"text","text":"Consecrate a fast;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.14","nodes":[{"kind":"text","text":"proclaim a solemn assembly!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.14","nodes":[{"kind":"text","text":"Gather the elders"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.14","nodes":[{"kind":"text","text":"and all the residents of the land"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.14","nodes":[{"kind":"text","text":"to the house of the LORD your God,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.14","nodes":[{"kind":"text","text":"and cry out to the LORD."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.15","number":15,"nodes":[{"kind":"text","text":"Alas for the day!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.15","nodes":[{"kind":"text","text":"For the Day of the LORD is near,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.15","nodes":[{"kind":"text","text":"and it will come"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.15","nodes":[{"kind":"text","text":"as destruction from the Almighty."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:15 "},{"kind":"text","text":"Hebrew "},{"kind":"em","children":[{"kind":"text","text":"Shaddai"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.16","number":16,"nodes":[{"kind":"text","text":"Has not the food been cut off"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.16","nodes":[{"kind":"text","text":"before our very eyes —"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.16","nodes":[{"kind":"text","text":"joy and gladness"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.16","nodes":[{"kind":"text","text":"from the house of our God?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.17","number":17,"nodes":[{"kind":"text","text":"The seeds lie shriveled beneath the clods;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.17","nodes":[{"kind":"text","text":"the storehouses are in ruins;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.17","nodes":[{"kind":"text","text":"the granaries are broken down,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.17","nodes":[{"kind":"text","text":"for the grain has withered away."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.18","number":18,"nodes":[{"kind":"text","text":"How the cattle groan!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.18","nodes":[{"kind":"text","text":"The herds wander in confusion"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.18","nodes":[{"kind":"text","text":"because they have no pasture."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.18","nodes":[{"kind":"text","text":"Even the flocks of sheep are suffering."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.19","number":19,"nodes":[{"kind":"text","text":"To You, O LORD, I call,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.19","nodes":[{"kind":"text","text":"for fire has consumed the open pastures"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.19","nodes":[{"kind":"text","text":"and flames have scorched all the trees of the field."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.1.20","number":20,"nodes":[{"kind":"text","text":"Even the beasts of the field pant for You,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.20","nodes":[{"kind":"text","text":"for the streams of water have dried up,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.1.20","nodes":[{"kind":"text","text":"and fire has consumed the open pastures."}]}]}]},{"book":"jol","number":2,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Army of Locusts"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.1","number":1,"nodes":[{"kind":"text","text":"Blow the ram’s horn in Zion;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.1","nodes":[{"kind":"text","text":"sound the alarm on My holy mountain!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.1","nodes":[{"kind":"text","text":"Let all who dwell in the land tremble,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.1","nodes":[{"kind":"text","text":"for the Day of the LORD is coming;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.1","nodes":[{"kind":"text","text":"indeed, it is near—"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.2","number":2,"nodes":[{"kind":"text","text":"a day of darkness and gloom,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.2","nodes":[{"kind":"text","text":"a day of clouds and blackness."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.2","nodes":[{"kind":"text","text":"Like the dawn overspreading the mountains"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.2","nodes":[{"kind":"text","text":"a great and strong army appears,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.2","nodes":[{"kind":"text","text":"such as never was of old,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.2","nodes":[{"kind":"text","text":"nor will ever be in ages to come."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.3","number":3,"nodes":[{"kind":"text","text":"Before them a fire devours,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.3","nodes":[{"kind":"text","text":"and behind them a flame scorches."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.3","nodes":[{"kind":"text","text":"The land before them is like the Garden of Eden,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.3","nodes":[{"kind":"text","text":"but behind them, it is like a desert wasteland —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.3","nodes":[{"kind":"text","text":"surely nothing will escape them."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.4","number":4,"nodes":[{"kind":"text","text":"Their appearance is like that of horses,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.4","nodes":[{"kind":"text","text":"and they gallop like swift steeds."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:4 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"like charioteers "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"like cavalry"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.5","number":5,"nodes":[{"kind":"text","text":"With a sound like that of chariots"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.5","nodes":[{"kind":"text","text":"they bound over the mountaintops,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.5","nodes":[{"kind":"text","text":"like the crackling of fire consuming stubble,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.5","nodes":[{"kind":"text","text":"like a mighty army deployed for battle."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.6","number":6,"nodes":[{"kind":"text","text":"Nations writhe in horror before them;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.6","nodes":[{"kind":"text","text":"every face turns pale."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.7","number":7,"nodes":[{"kind":"text","text":"They charge like mighty men;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.7","nodes":[{"kind":"text","text":"they scale the walls like men of war."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.7","nodes":[{"kind":"text","text":"Each one marches in formation,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.7","nodes":[{"kind":"text","text":"not swerving from the course."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.8","number":8,"nodes":[{"kind":"text","text":"They do not jostle one another;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.8","nodes":[{"kind":"text","text":"each proceeds in his path."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.8","nodes":[{"kind":"text","text":"They burst through the defenses,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.8","nodes":[{"kind":"text","text":"never breaking ranks."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.9","number":9,"nodes":[{"kind":"text","text":"They storm the city;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.9","nodes":[{"kind":"text","text":"they run along the wall;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.9","nodes":[{"kind":"text","text":"they climb into houses,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.9","nodes":[{"kind":"text","text":"entering through windows like thieves."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.10","number":10,"nodes":[{"kind":"text","text":"Before them the earth quakes;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.10","nodes":[{"kind":"text","text":"the heavens tremble."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.10","nodes":[{"kind":"text","text":"The sun and moon grow dark,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.10","nodes":[{"kind":"text","text":"and the stars lose their brightness."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.11","number":11,"nodes":[{"kind":"text","text":"The LORD raises His voice"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.11","nodes":[{"kind":"text","text":"in the presence of His army."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.11","nodes":[{"kind":"text","text":"Indeed, His camp is very large,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.11","nodes":[{"kind":"text","text":"for mighty are those who obey His command."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.11","nodes":[{"kind":"text","text":"For the Day of the LORD is great and very dreadful."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.11","nodes":[{"kind":"text","text":"Who can endure it?"}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Return with All Your Heart"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.12","number":12,"nodes":[{"kind":"text","text":"“Yet even now,”"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.12","nodes":[{"kind":"text","text":"declares the LORD,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.12","nodes":[{"kind":"text","text":"“return to Me with all your heart,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.12","nodes":[{"kind":"text","text":"with fasting, weeping, and mourning.”"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.13","number":13,"nodes":[{"kind":"text","text":"So rend your hearts and not your garments,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.13","nodes":[{"kind":"text","text":"and return to the LORD your God."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.13","nodes":[{"kind":"text","text":"For He is gracious and compassionate,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.13","nodes":[{"kind":"text","text":"slow to anger, abounding in loving devotion."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:13 "},{"kind":"text","text":"Forms of the Hebrew "},{"kind":"em","children":[{"kind":"text","text":"chesed "}]},{"kind":"text","text":"are translated here and in most cases throughout the Scriptures as "},{"kind":"em","children":[{"kind":"text","text":"loving devotion"}]},{"kind":"text","text":"; the range of meaning includes "},{"kind":"em","children":[{"kind":"text","text":"love"}]},{"kind":"text","text":", "},{"kind":"em","children":[{"kind":"text","text":"goodness"}]},{"kind":"text","text":", "},{"kind":"em","children":[{"kind":"text","text":"kindness"}]},{"kind":"text","text":", "},{"kind":"em","children":[{"kind":"text","text":"faithfulness"}]},{"kind":"text","text":", and "},{"kind":"em","children":[{"kind":"text","text":"mercy"}]},{"kind":"text","text":", as well as "},{"kind":"em","children":[{"kind":"text","text":"loyalty to a covenant"}]},{"kind":"text","text":"."}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.13","nodes":[{"kind":"text","text":"And He relents from sending disaster."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.14","number":14,"nodes":[{"kind":"text","text":"Who knows? He may turn and relent"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.14","nodes":[{"kind":"text","text":"and leave a blessing behind Him —"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.14","nodes":[{"kind":"text","text":"grain and drink offerings"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.14","nodes":[{"kind":"text","text":"for the LORD your God."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.15","number":15,"nodes":[{"kind":"text","text":"Blow the ram’s horn in Zion,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.15","nodes":[{"kind":"text","text":"consecrate a fast,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.15","nodes":[{"kind":"text","text":"proclaim a sacred assembly."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.16","number":16,"nodes":[{"kind":"text","text":"Gather the people, sanctify the congregation,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.16","nodes":[{"kind":"text","text":"assemble the aged, gather the children,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.16","nodes":[{"kind":"text","text":"even those nursing at the breast."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.16","nodes":[{"kind":"text","text":"Let the bridegroom leave his room,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.16","nodes":[{"kind":"text","text":"and the bride her chamber."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.17","number":17,"nodes":[{"kind":"text","text":"Let the priests who minister before the LORD"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"weep between the portico and the altar,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"saying, “Spare Your people, O LORD,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"and do not make Your heritage a reproach,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"an object of scorn among the nations."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"Why should they say among the peoples,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.17","nodes":[{"kind":"text","text":"‘Where is their God?’”"}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Restoration Promised"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.18","number":18,"nodes":[{"kind":"text","text":"Then the LORD became jealous for His land,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.18","nodes":[{"kind":"text","text":"and He spared His people."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.19","number":19,"nodes":[{"kind":"text","text":"And the LORD answered His people:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.19","nodes":[{"kind":"text","text":"“Behold, I will send you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.19","nodes":[{"kind":"text","text":"grain, new wine, and oil,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.19","nodes":[{"kind":"text","text":"and by them you will be satisfied."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.19","nodes":[{"kind":"text","text":"I will never again make you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.19","nodes":[{"kind":"text","text":"a reproach among the nations."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.20","number":20,"nodes":[{"kind":"text","text":"The northern army I will drive away from you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"banishing it to a barren and desolate land,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"its front ranks into the Eastern Sea,"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:20 "},{"kind":"text","text":"That is, the Dead Sea"}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"and its rear guard into the Western Sea."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:20 "},{"kind":"text","text":"That is, the Mediterranean Sea, also called the Great Sea"}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"And its stench will rise;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"its foul odor will ascend."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.20","nodes":[{"kind":"text","text":"For He has done great things."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.21","number":21,"nodes":[{"kind":"text","text":"Do not be afraid, O land;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.21","nodes":[{"kind":"text","text":"rejoice and be glad,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.21","nodes":[{"kind":"text","text":"for the LORD has done great things."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.22","number":22,"nodes":[{"kind":"text","text":"Do not be afraid, O beasts of the field,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.22","nodes":[{"kind":"text","text":"for the open pastures have turned green,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.22","nodes":[{"kind":"text","text":"the trees bear their fruit,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.22","nodes":[{"kind":"text","text":"and the fig tree and vine yield their best."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:22 "},{"kind":"text","text":"Literally "},{"kind":"em","children":[{"kind":"text","text":"their strength"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.23","number":23,"nodes":[{"kind":"text","text":"Be glad, O children of Zion,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.23","nodes":[{"kind":"text","text":"and rejoice in the LORD your God,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.23","nodes":[{"kind":"text","text":"for He has given you the autumn rains"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.23","nodes":[{"kind":"text","text":"for your vindication."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.23","nodes":[{"kind":"text","text":"He sends you showers,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.23","nodes":[{"kind":"text","text":"both autumn and spring rains, as before."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.24","number":24,"nodes":[{"kind":"text","text":"The threshing floors will be full of grain,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.24","nodes":[{"kind":"text","text":"and the vats will overflow with new wine and oil."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.25","number":25,"nodes":[{"kind":"text","text":"I will repay you for the years eaten by locusts —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.25","nodes":[{"kind":"text","text":"the swarming locust, the young locust,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.25","nodes":[{"kind":"text","text":"the destroying locust, and the devouring locust"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:25 "},{"kind":"text","text":"The precise identification of the four kinds of insects mentioned here is uncertain."}]},{"kind":"text","text":"—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.25","nodes":[{"kind":"text","text":"My great army that I sent against you."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.26","number":26,"nodes":[{"kind":"text","text":"You will have plenty to eat,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.26","nodes":[{"kind":"text","text":"until you are satisfied."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.26","nodes":[{"kind":"text","text":"You will praise the name of the LORD your God,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.26","nodes":[{"kind":"text","text":"who has worked wonders for you."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.26","nodes":[{"kind":"text","text":"My people will never again"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.26","nodes":[{"kind":"text","text":"be put to shame."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.27","number":27,"nodes":[{"kind":"text","text":"Then you will know that I am present in Israel"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.27","nodes":[{"kind":"text","text":"and that I am the LORD your God,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.27","nodes":[{"kind":"text","text":"and there is no other."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.27","nodes":[{"kind":"text","text":"My people will never again"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.27","nodes":[{"kind":"text","text":"be put to shame."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"I Will Pour Out My Spirit"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.28","number":28,"nodes":[{"kind":"text","text":"And afterward, I will pour out My Spirit on all people."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.28","nodes":[{"kind":"text","text":"Your sons and daughters will prophesy,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.28","nodes":[{"kind":"text","text":"your old men will dream dreams,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.28","nodes":[{"kind":"text","text":"your young men will see visions."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.29","number":29,"nodes":[{"kind":"text","text":"Even on My menservants and maidservants,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.29","nodes":[{"kind":"text","text":"I will pour out My Spirit in those days."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.30","number":30,"nodes":[{"kind":"text","text":"I will show wonders in the heavens and on the earth,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.30","nodes":[{"kind":"text","text":"blood and fire and columns"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:30 "},{"kind":"text","text":"LXX "},{"kind":"em","children":[{"kind":"text","text":"clouds "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"billows"}]}]},{"kind":"text","text":" of smoke."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.31","number":31,"nodes":[{"kind":"text","text":"The sun will be turned to darkness"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.31","nodes":[{"kind":"text","text":"and the moon to blood"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.31","nodes":[{"kind":"text","text":"before the coming of the great and awesome"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:31 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"dreadful"}]},{"kind":"text","text":"; LXX "},{"kind":"em","children":[{"kind":"text","text":"glorious"}]}]},{"kind":"text","text":" Day of the LORD."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.32","number":32,"nodes":[{"kind":"text","text":"And everyone who calls on the name of the LORD"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.32","nodes":[{"kind":"text","text":"will be saved;"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:32 "},{"kind":"text","text":"Cited in Acts 2:17–21 and Romans 10:13"}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.2.32","nodes":[{"kind":"text","text":"for on Mount Zion and in Jerusalem"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.32","nodes":[{"kind":"text","text":"there will be deliverance, as the LORD has promised,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.2.32","nodes":[{"kind":"text","text":"among the remnant called by the LORD.[’’]"}]}]}]},{"book":"jol","number":3,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The LORD Judges the Nations"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.1","number":1,"nodes":[{"kind":"text","text":"“Yes, in those days and at that time,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.1","nodes":[{"kind":"text","text":"when I restore Judah and Jerusalem from captivity,"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:1 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"restore the fortunes of Judah and Jerusalem"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.2","number":2,"nodes":[{"kind":"text","text":"I will gather all the nations"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.2","nodes":[{"kind":"text","text":"and bring them down to the Valley of Jehoshaphat."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:2 "},{"kind":"em","children":[{"kind":"text","text":"Jehoshaphat "}]},{"kind":"text","text":"means "},{"kind":"em","children":[{"kind":"text","text":"the LORD judges"}]},{"kind":"text","text":"; also in verse 12."}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.2","nodes":[{"kind":"text","text":"There I will enter into judgment against them"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.2","nodes":[{"kind":"text","text":"concerning My people, My inheritance, Israel,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.2","nodes":[{"kind":"text","text":"whom they have scattered among the nations"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.2","nodes":[{"kind":"text","text":"as they divided up My land."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.3","number":3,"nodes":[{"kind":"text","text":"They cast lots for My people;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.3","nodes":[{"kind":"text","text":"they bartered a boy for a prostitute"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.3","nodes":[{"kind":"text","text":"and sold a girl for wine to drink."}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"jol.3.4","number":4,"nodes":[{"kind":"text","text":"Now what do you have against Me, O Tyre, Sidon, and all the regions of Philistia? Are you rendering against Me a recompense? If you retaliate against Me, I will swiftly and speedily return your recompense upon your heads. "}]},{"id":"jol.3.5","number":5,"nodes":[{"kind":"text","text":"For you took My silver and gold and carried off My finest treasures to your temples."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:5 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"palaces"}]}]},{"kind":"text","text":" "}]},{"id":"jol.3.6","number":6,"nodes":[{"kind":"text","text":"You sold the people of Judah and Jerusalem to the Greeks,"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:6 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"to the peoples of Javan"}]}]},{"kind":"text","text":" to send them far from their homeland."}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"jol.3.7","number":7,"nodes":[{"kind":"text","text":"Behold, I will rouse them from the places to which you sold them; I will return your recompense upon your heads. "}]},{"id":"jol.3.8","number":8,"nodes":[{"kind":"text","text":"I will sell your sons and daughters into the hands of the people of Judah, and they will sell them to the Sabeans — to a distant nation.”"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"jol.3.8","nodes":[{"kind":"text","text":"Indeed, the LORD has spoken."}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"jol.3.9","number":9,"nodes":[{"kind":"text","text":"Proclaim this among the nations:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.9","nodes":[{"kind":"text","text":"“Prepare for war;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.9","nodes":[{"kind":"text","text":"rouse the mighty men;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.9","nodes":[{"kind":"text","text":"let all the men of war"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.9","nodes":[{"kind":"text","text":"advance and attack!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.10","number":10,"nodes":[{"kind":"text","text":"Beat your plowshares into swords"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.10","nodes":[{"kind":"text","text":"and your pruning hooks into spears."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.10","nodes":[{"kind":"text","text":"Let the weak say, ‘I am strong!’"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.11","number":11,"nodes":[{"kind":"text","text":"Come quickly, all you surrounding nations,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.11","nodes":[{"kind":"text","text":"and gather yourselves."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.11","nodes":[{"kind":"text","text":"Bring down Your mighty ones,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.11","nodes":[{"kind":"text","text":"O LORD."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.12","number":12,"nodes":[{"kind":"text","text":"Let the nations be roused"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.12","nodes":[{"kind":"text","text":"and advance to the Valley of Jehoshaphat,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.12","nodes":[{"kind":"text","text":"for there I will sit down"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.12","nodes":[{"kind":"text","text":"to judge all the nations on every side."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.13","number":13,"nodes":[{"kind":"text","text":"Swing the sickle,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.13","nodes":[{"kind":"text","text":"for the harvest is ripe."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:13 "},{"kind":"text","text":"LXX "},{"kind":"em","children":[{"kind":"text","text":"the harvest has come"}]},{"kind":"text","text":"; see also Mark 4:29."}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.13","nodes":[{"kind":"text","text":"Come, trample the grapes,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.13","nodes":[{"kind":"text","text":"for the winepress is full;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.13","nodes":[{"kind":"text","text":"the wine vats overflow"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.13","nodes":[{"kind":"text","text":"because their wickedness is great."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.14","number":14,"nodes":[{"kind":"text","text":"Multitudes, multitudes"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.14","nodes":[{"kind":"text","text":"in the valley of decision!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.14","nodes":[{"kind":"text","text":"For the Day of the LORD is near"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.14","nodes":[{"kind":"text","text":"in the valley of decision."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.15","number":15,"nodes":[{"kind":"text","text":"The sun and moon will grow dark,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.15","nodes":[{"kind":"text","text":"and the stars will no longer shine."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.16","number":16,"nodes":[{"kind":"text","text":"The LORD will roar from Zion"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.16","nodes":[{"kind":"text","text":"and raise His voice from Jerusalem;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.16","nodes":[{"kind":"text","text":"heaven and earth will tremble."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.16","nodes":[{"kind":"text","text":"But the LORD will be a refuge for His people,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.16","nodes":[{"kind":"text","text":"a stronghold for the people of Israel."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Blessings for God’s People"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.17","number":17,"nodes":[{"kind":"text","text":"Then you will know that I am the LORD your God,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.17","nodes":[{"kind":"text","text":"who dwells in Zion, My holy mountain."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.17","nodes":[{"kind":"text","text":"Jerusalem will be holy,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.17","nodes":[{"kind":"text","text":"never again to be overrun by foreigners."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.18","number":18,"nodes":[{"kind":"text","text":"And in that day the mountains will drip with sweet wine,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.18","nodes":[{"kind":"text","text":"and the hills will flow with milk."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.18","nodes":[{"kind":"text","text":"All the streams of Judah will run with water,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.18","nodes":[{"kind":"text","text":"and a spring will flow from the house of the LORD"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.18","nodes":[{"kind":"text","text":"to water the Valley of Acacias."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:18 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"Valley of Shittim"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.19","number":19,"nodes":[{"kind":"text","text":"Egypt will become desolate,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.19","nodes":[{"kind":"text","text":"and Edom a desert wasteland,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.19","nodes":[{"kind":"text","text":"because of the violence done to the people of Judah,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.19","nodes":[{"kind":"text","text":"in whose land they shed innocent blood."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.20","number":20,"nodes":[{"kind":"text","text":"But Judah will be inhabited forever,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.20","nodes":[{"kind":"text","text":"and Jerusalem from generation to generation."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"jol.3.21","number":21,"nodes":[{"kind":"text","text":"For I will avenge their blood,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"jol.3.21","nodes":[{"kind":"text","text":"which I have not yet avenged."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:21 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"For I will pardon their bloodguilt, which I have not yet pardoned."}]}]},{"kind":"text","text":"”"}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"jol.3.21","nodes":[{"kind":"text","text":"For the LORD dwells in Zion."}]}]}]}]}
