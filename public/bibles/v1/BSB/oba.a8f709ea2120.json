{"format":1,"book":"oba","name":"Obadiah","chapters":[{"book":"oba","number":1,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Destruction of Edom"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"oba.1.1","number":1,"nodes":[{"kind":"text","text":"This is the vision of Obadiah:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.1","nodes":[{"kind":"text","text":"This is what the Lord GOD says about Edom —"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.1","nodes":[{"kind":"text","text":"We have heard a message from the LORD;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.1","nodes":[{"kind":"text","text":"an envoy has been sent among the nations"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.1","nodes":[{"kind":"text","text":"to say, “Rise up,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.1","nodes":[{"kind":"text","text":"and let us go to battle against her!”—"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.2","number":2,"nodes":[{"kind":"text","text":"“Behold, I will make you small among the nations;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.2","nodes":[{"kind":"text","text":"you will be deeply despised."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.3","number":3,"nodes":[{"kind":"text","text":"The pride of your heart has deceived you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.3","nodes":[{"kind":"text","text":"O dwellers in the clefts of the rocks"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:3 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"in the retreats of Sela"}]}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.3","nodes":[{"kind":"text","text":"whose habitation is the heights,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.3","nodes":[{"kind":"text","text":"who say in your heart,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.3","nodes":[{"kind":"text","text":"‘Who can bring me down to the ground?’"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.4","number":4,"nodes":[{"kind":"text","text":"Though you soar like the eagle"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.4","nodes":[{"kind":"text","text":"and make your nest among the stars,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.4","nodes":[{"kind":"text","text":"even from there I will bring you down,”"}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"oba.1.4","nodes":[{"kind":"text","text":"declares the LORD."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.5","number":5,"nodes":[{"kind":"text","text":"“If thieves came to you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.5","nodes":[{"kind":"text","text":"if robbers by night —"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.5","nodes":[{"kind":"text","text":"oh, how you will be ruined —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.5","nodes":[{"kind":"text","text":"would they not steal only what they wanted?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.5","nodes":[{"kind":"text","text":"If grape gatherers came to you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.5","nodes":[{"kind":"text","text":"would they not leave some gleanings?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.6","number":6,"nodes":[{"kind":"text","text":"But how Esau will be pillaged,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.6","nodes":[{"kind":"text","text":"his hidden treasures sought out!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.7","number":7,"nodes":[{"kind":"text","text":"All the men allied with you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"will drive you to the border;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"the men at peace with you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"will deceive and overpower you."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"Those who eat your bread"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:7 "},{"kind":"text","text":"Hebrew does not include "},{"kind":"em","children":[{"kind":"text","text":"Those who eat"}]},{"kind":"text","text":"."}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"will set a trap for you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.7","nodes":[{"kind":"text","text":"without your awareness of it."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.8","number":8,"nodes":[{"kind":"text","text":"In that day, declares the LORD,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.8","nodes":[{"kind":"text","text":"will I not destroy the wise men of Edom"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.8","nodes":[{"kind":"text","text":"and the men of understanding"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.8","nodes":[{"kind":"text","text":"in the mountains of Esau?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.9","number":9,"nodes":[{"kind":"text","text":"Then your mighty men, O Teman,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.9","nodes":[{"kind":"text","text":"will be terrified,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.9","nodes":[{"kind":"text","text":"so that everyone in the mountains of Esau"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.9","nodes":[{"kind":"text","text":"will be cut down in the slaughter."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.10","number":10,"nodes":[{"kind":"text","text":"Because of the violence against your brother Jacob,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.10","nodes":[{"kind":"text","text":"you will be covered with shame"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.10","nodes":[{"kind":"text","text":"and cut off forever."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.11","number":11,"nodes":[{"kind":"text","text":"On the day you stood aloof"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.11","nodes":[{"kind":"text","text":"while strangers carried off his wealth"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.11","nodes":[{"kind":"text","text":"and foreigners entered his gate"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.11","nodes":[{"kind":"text","text":"and cast lots for Jerusalem,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.11","nodes":[{"kind":"text","text":"you were just like one of them."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.12","number":12,"nodes":[{"kind":"text","text":"But you should not gloat in that day,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.12","nodes":[{"kind":"text","text":"your brother’s day of misfortune,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.12","nodes":[{"kind":"text","text":"nor rejoice over the people of Judah"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.12","nodes":[{"kind":"text","text":"in the day of their destruction,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.12","nodes":[{"kind":"text","text":"nor boast proudly"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:12 "},{"kind":"text","text":"Hebrew "},{"kind":"em","children":[{"kind":"text","text":"nor enlarge your mouth"}]}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.12","nodes":[{"kind":"text","text":"in the day of their distress."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.13","number":13,"nodes":[{"kind":"text","text":"You should not enter the gate of My people"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.13","nodes":[{"kind":"text","text":"in the day of their disaster,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.13","nodes":[{"kind":"text","text":"nor gloat over their affliction"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.13","nodes":[{"kind":"text","text":"in the day of their disaster,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.13","nodes":[{"kind":"text","text":"nor loot their wealth"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.13","nodes":[{"kind":"text","text":"in the day of their disaster."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.14","number":14,"nodes":[{"kind":"text","text":"Nor should you stand at the crossroads"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.14","nodes":[{"kind":"text","text":"to cut off their fugitives,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.14","nodes":[{"kind":"text","text":"nor deliver up their survivors"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.14","nodes":[{"kind":"text","text":"in the day of their distress."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Deliverance of Israel"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.15","number":15,"nodes":[{"kind":"text","text":"For the Day of the LORD is near"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.15","nodes":[{"kind":"text","text":"for all the nations."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.15","nodes":[{"kind":"text","text":"As you have done, it will be done to you;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.15","nodes":[{"kind":"text","text":"your recompense will return upon your own head."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.16","number":16,"nodes":[{"kind":"text","text":"For as you drank on My holy mountain,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.16","nodes":[{"kind":"text","text":"so all the nations will drink continually."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.16","nodes":[{"kind":"text","text":"They will drink and gulp it down;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.16","nodes":[{"kind":"text","text":"they will be as if they had never existed."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.17","number":17,"nodes":[{"kind":"text","text":"But on Mount Zion there will be deliverance,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.17","nodes":[{"kind":"text","text":"and it will be holy,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.17","nodes":[{"kind":"text","text":"and the house of Jacob"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.17","nodes":[{"kind":"text","text":"will reclaim their possession."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.18","number":18,"nodes":[{"kind":"text","text":"Then the house of Jacob will be a blazing fire,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"and the house of Joseph a burning flame;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"but the house of Esau will be stubble —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"Jacob will set it ablaze and consume it."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"Therefore no survivor will remain"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"from the house of Esau.”"}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"oba.1.18","nodes":[{"kind":"text","text":"For the LORD has spoken."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.19","number":19,"nodes":[{"kind":"text","text":"Those from the Negev will possess the mountains of Esau;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.19","nodes":[{"kind":"text","text":"those from the foothills"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:19 "},{"kind":"text","text":"Hebrew "},{"kind":"em","children":[{"kind":"text","text":"Shephelah "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"lowlands"}]},{"kind":"text","text":"; that is, the western foothills of Judea"}]},{"kind":"text","text":" will possess the land of the Philistines."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.19","nodes":[{"kind":"text","text":"They will occupy the fields of Ephraim and Samaria,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.19","nodes":[{"kind":"text","text":"and Benjamin will possess Gilead."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.20","number":20,"nodes":[{"kind":"text","text":"And the exiles of this host of the Israelites"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.20","nodes":[{"kind":"text","text":"will possess the land of the Canaanites as far as Zarephath;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.20","nodes":[{"kind":"text","text":"and the exiles from Jerusalem who are in Sepharad"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.20","nodes":[{"kind":"text","text":"will possess the cities of the Negev."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.21","number":21,"nodes":[{"kind":"text","text":"The deliverers will ascend"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:21 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"The deliverers will go up from"}]},{"kind":"text","text":"; LXX "},{"kind":"em","children":[{"kind":"text","text":"Those being delivered will go up"}]}]},{"kind":"text","text":" Mount Zion"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"oba.1.21","nodes":[{"kind":"text","text":"to rule over the mountains of Esau."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"oba.1.21","nodes":[{"kind":"text","text":"And the kingdom will belong to the LORD."}]}]}]}]}
