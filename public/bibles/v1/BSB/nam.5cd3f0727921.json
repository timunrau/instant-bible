{"format":1,"book":"nam","name":"Nahum","chapters":[{"book":"nam","number":1,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Burden against Nineveh"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"nam.1.1","number":1,"nodes":[{"kind":"text","text":"This is the burden against Nineveh, the book of the vision of Nahum the Elkoshite:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.2","number":2,"nodes":[{"kind":"text","text":"The LORD is a jealous and avenging God;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.2","nodes":[{"kind":"text","text":"the LORD is avenging and full of wrath."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.2","nodes":[{"kind":"text","text":"The LORD takes vengeance on His foes"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.2","nodes":[{"kind":"text","text":"and reserves wrath for His enemies."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.3","number":3,"nodes":[{"kind":"text","text":"The LORD is slow to anger"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.3","nodes":[{"kind":"text","text":"and great in power;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.3","nodes":[{"kind":"text","text":"the LORD will by no means"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.3","nodes":[{"kind":"text","text":"leave the guilty unpunished."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.3","nodes":[{"kind":"text","text":"His path is in the whirlwind and storm,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.3","nodes":[{"kind":"text","text":"and clouds are the dust beneath His feet."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.4","number":4,"nodes":[{"kind":"text","text":"He rebukes the sea and dries it up;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.4","nodes":[{"kind":"text","text":"He makes all the rivers run dry."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.4","nodes":[{"kind":"text","text":"Bashan and Carmel wither,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.4","nodes":[{"kind":"text","text":"and the flower of Lebanon wilts."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.5","number":5,"nodes":[{"kind":"text","text":"The mountains quake before Him,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.5","nodes":[{"kind":"text","text":"and the hills melt away;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.5","nodes":[{"kind":"text","text":"the earth trembles at His presence—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.5","nodes":[{"kind":"text","text":"the world and all its dwellers."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.6","number":6,"nodes":[{"kind":"text","text":"Who can withstand His indignation?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.6","nodes":[{"kind":"text","text":"Who can endure His burning anger?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.6","nodes":[{"kind":"text","text":"His wrath is poured out like fire;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.6","nodes":[{"kind":"text","text":"even rocks are shattered before Him."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.7","number":7,"nodes":[{"kind":"text","text":"The LORD is good,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.7","nodes":[{"kind":"text","text":"a stronghold in the day of distress;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.7","nodes":[{"kind":"text","text":"He cares for those who trust in Him."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.8","number":8,"nodes":[{"kind":"text","text":"But with an overwhelming flood"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.8","nodes":[{"kind":"text","text":"He will make an end of Nineveh"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:8 "},{"kind":"text","text":"Literally "},{"kind":"em","children":[{"kind":"text","text":"of her place"}]}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.8","nodes":[{"kind":"text","text":"and pursue His enemies into darkness."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.9","number":9,"nodes":[{"kind":"text","text":"Whatever you plot against the LORD,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.9","nodes":[{"kind":"text","text":"He will bring to an end."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.9","nodes":[{"kind":"text","text":"Affliction will not rise up"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.9","nodes":[{"kind":"text","text":"a second time."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.10","number":10,"nodes":[{"kind":"text","text":"For they will be entangled as with thorns"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.10","nodes":[{"kind":"text","text":"and consumed like the drink of a drunkard —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.10","nodes":[{"kind":"text","text":"like stubble that is fully dry."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.11","number":11,"nodes":[{"kind":"text","text":"From you, O Nineveh, comes forth"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.11","nodes":[{"kind":"text","text":"a plotter of evil against the LORD,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.11","nodes":[{"kind":"text","text":"a counselor of wickedness."}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"nam.1.12","number":12,"nodes":[{"kind":"text","text":"This is what the LORD says:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.12","nodes":[{"kind":"text","text":"“Though they are allied and numerous,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.12","nodes":[{"kind":"text","text":"yet they will be cut down and pass away."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.12","nodes":[{"kind":"text","text":"Though I have afflicted you, O Judah,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.12","nodes":[{"kind":"text","text":"I will afflict you no longer."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.13","number":13,"nodes":[{"kind":"text","text":"For I will now break their yoke from your neck"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.13","nodes":[{"kind":"text","text":"and tear away your shackles.”"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"nam.1.14","number":14,"nodes":[{"kind":"text","text":"The LORD has issued a command concerning you, O Nineveh:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"“There will be no descendants"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"to carry on your name."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"I will cut off the carved image and cast idol"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"from the house of your gods;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"I will prepare your grave,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.14","nodes":[{"kind":"text","text":"for you are contemptible.”"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.15","number":15,"nodes":[{"kind":"text","text":"Look to the mountains—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"the feet of one who brings good news,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"who proclaims peace!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"Celebrate your feasts, O Judah;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"fulfill your vows."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"For the wicked will never again march through you;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.1.15","nodes":[{"kind":"text","text":"they will be utterly cut off."}]}]}]},{"book":"nam","number":2,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The Overthrow of Nineveh"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.1","number":1,"nodes":[{"kind":"text","text":"One who scatters advances"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.1","nodes":[{"kind":"text","text":"against you, O Nineveh."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.1","nodes":[{"kind":"text","text":"Guard the fortress!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.1","nodes":[{"kind":"text","text":"Watch the road!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.1","nodes":[{"kind":"text","text":"Brace yourselves!"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:1 "},{"kind":"text","text":"Hebrew "},{"kind":"em","children":[{"kind":"text","text":"Strengthen your loins!"}]}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.1","nodes":[{"kind":"text","text":"Summon all your strength!"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.2","number":2,"nodes":[{"kind":"text","text":"For the LORD will restore the splendor of Jacob"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.2","nodes":[{"kind":"text","text":"like the splendor of Israel,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.2","nodes":[{"kind":"text","text":"though destroyers have laid them waste"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.2","nodes":[{"kind":"text","text":"and ruined the branches of their vine."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.3","number":3,"nodes":[{"kind":"text","text":"The shields of his mighty men are red;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.3","nodes":[{"kind":"text","text":"the valiant warriors are dressed in scarlet."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.3","nodes":[{"kind":"text","text":"The fittings of the chariots flash like fire"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.3","nodes":[{"kind":"text","text":"on the day they are prepared,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.3","nodes":[{"kind":"text","text":"and the spears of cypress"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.3","nodes":[{"kind":"text","text":"have been brandished."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:3 "},{"kind":"text","text":"Hebrew; alternately, the spears may be of "},{"kind":"em","children":[{"kind":"text","text":"pine "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"juniper "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"fir"}]},{"kind":"text","text":"; LXX and Syriac "},{"kind":"em","children":[{"kind":"text","text":"they are prepared, and the horsemen rush to and fro."}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.4","number":4,"nodes":[{"kind":"text","text":"The chariots dash through the streets;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.4","nodes":[{"kind":"text","text":"they rush around the plazas,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.4","nodes":[{"kind":"text","text":"appearing like torches,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.4","nodes":[{"kind":"text","text":"darting about like lightning."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.5","number":5,"nodes":[{"kind":"text","text":"He summons his nobles;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.5","nodes":[{"kind":"text","text":"they stumble as they advance."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.5","nodes":[{"kind":"text","text":"They race to its wall;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.5","nodes":[{"kind":"text","text":"the protective shield is set in place."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.6","number":6,"nodes":[{"kind":"text","text":"The river gates are thrown open"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.6","nodes":[{"kind":"text","text":"and the palace collapses."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.7","number":7,"nodes":[{"kind":"text","text":"It is decreed that the city be exiled"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.7","nodes":[{"kind":"text","text":"and carried away;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.7","nodes":[{"kind":"text","text":"her maidservants moan like doves,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.7","nodes":[{"kind":"text","text":"and beat upon their breasts."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.8","number":8,"nodes":[{"kind":"text","text":"Nineveh has been like a pool of water"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.8","nodes":[{"kind":"text","text":"throughout her days,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.8","nodes":[{"kind":"text","text":"but now it is draining away."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.8","nodes":[{"kind":"text","text":"“Stop! Stop!” they cry,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.8","nodes":[{"kind":"text","text":"but no one turns back."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.9","number":9,"nodes":[{"kind":"text","text":"“Plunder the silver!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.9","nodes":[{"kind":"text","text":"Plunder the gold!”"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.9","nodes":[{"kind":"text","text":"There is no end to the treasure,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.9","nodes":[{"kind":"text","text":"an abundance of every precious thing."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.10","number":10,"nodes":[{"kind":"text","text":"She is emptied!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.10","nodes":[{"kind":"text","text":"Yes , she is desolate and laid waste!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.10","nodes":[{"kind":"text","text":"Hearts melt, knees knock,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.10","nodes":[{"kind":"text","text":"bodies tremble, and every face grows pale!"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.11","number":11,"nodes":[{"kind":"text","text":"Where is the lions’ lair"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.11","nodes":[{"kind":"text","text":"or the feeding ground of the young lions,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.11","nodes":[{"kind":"text","text":"where the lion and lioness prowled with their cubs,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.11","nodes":[{"kind":"text","text":"with nothing to frighten them away?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.12","number":12,"nodes":[{"kind":"text","text":"The lion mauled enough for its cubs"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.12","nodes":[{"kind":"text","text":"and strangled prey for the lioness."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.12","nodes":[{"kind":"text","text":"It filled its dens with the kill,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.12","nodes":[{"kind":"text","text":"and its lairs with mauled prey."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.13","number":13,"nodes":[{"kind":"text","text":"“Behold, I am against you,”"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"declares the LORD of Hosts."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"“I will reduce your chariots to cinders,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"and the sword will devour your young lions."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"I will cut off your prey from the earth,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"and the voices of your messengers"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.2.13","nodes":[{"kind":"text","text":"will no longer be heard.”"}]}]}]},{"book":"nam","number":3,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Judgment on Nineveh"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.1","number":1,"nodes":[{"kind":"text","text":"Woe to the city of blood,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.1","nodes":[{"kind":"text","text":"full of lies,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.1","nodes":[{"kind":"text","text":"full of plunder,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.1","nodes":[{"kind":"text","text":"never without prey."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.2","number":2,"nodes":[{"kind":"text","text":"The crack of the whip,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.2","nodes":[{"kind":"text","text":"the rumble of the wheel,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.2","nodes":[{"kind":"text","text":"galloping horse"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.2","nodes":[{"kind":"text","text":"and bounding chariot!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.3","number":3,"nodes":[{"kind":"text","text":"Charging horseman,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"flashing sword,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"shining spear;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"heaps of slain,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"mounds of corpses,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"dead bodies without end—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.3","nodes":[{"kind":"text","text":"they stumble over their dead—"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.4","number":4,"nodes":[{"kind":"text","text":"because of the many harlotries of the harlot,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.4","nodes":[{"kind":"text","text":"the seductive mistress of sorcery,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.4","nodes":[{"kind":"text","text":"who betrays nations by her prostitution"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.4","nodes":[{"kind":"text","text":"and clans by her witchcraft."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.5","number":5,"nodes":[{"kind":"text","text":"“Behold, I am against you,”"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.5","nodes":[{"kind":"text","text":"declares the LORD of Hosts."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.5","nodes":[{"kind":"text","text":"“I will lift your skirts over your face."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.5","nodes":[{"kind":"text","text":"I will show your nakedness to the nations"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.5","nodes":[{"kind":"text","text":"and your shame to the kingdoms."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.6","number":6,"nodes":[{"kind":"text","text":"I will pelt you with filth"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.6","nodes":[{"kind":"text","text":"and treat you with contempt;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.6","nodes":[{"kind":"text","text":"I will make a spectacle of you."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.7","number":7,"nodes":[{"kind":"text","text":"Then all who see you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.7","nodes":[{"kind":"text","text":"will recoil from you and say,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.7","nodes":[{"kind":"text","text":"‘Nineveh is devastated;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.7","nodes":[{"kind":"text","text":"who will grieve for her?’"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.7","nodes":[{"kind":"text","text":"Where can I find"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.7","nodes":[{"kind":"text","text":"comforters for you?”"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.8","number":8,"nodes":[{"kind":"text","text":"Are you better than Thebes,"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:8 "},{"kind":"text","text":"Hebrew "},{"kind":"em","children":[{"kind":"text","text":"No-amon"}]}]}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.8","nodes":[{"kind":"text","text":"stationed by the Nile with water around her,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.8","nodes":[{"kind":"text","text":"whose rampart was the sea,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.8","nodes":[{"kind":"text","text":"whose wall was the water?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.9","number":9,"nodes":[{"kind":"text","text":"Cush"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:9 "},{"kind":"text","text":"That is, the upper Nile region"}]},{"kind":"text","text":" and Egypt were her boundless strength;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.9","nodes":[{"kind":"text","text":"Put and Libya were her allies."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.10","number":10,"nodes":[{"kind":"text","text":"Yet she became an exile;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.10","nodes":[{"kind":"text","text":"she went into captivity."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.10","nodes":[{"kind":"text","text":"Her infants were dashed to pieces"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.10","nodes":[{"kind":"text","text":"at the head of every street."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.10","nodes":[{"kind":"text","text":"They cast lots for her dignitaries,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.10","nodes":[{"kind":"text","text":"and all her nobles were bound in chains."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.11","number":11,"nodes":[{"kind":"text","text":"You too will become drunk;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.11","nodes":[{"kind":"text","text":"you will go into hiding"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.11","nodes":[{"kind":"text","text":"and seek refuge from the enemy."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.12","number":12,"nodes":[{"kind":"text","text":"All your fortresses are fig trees"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.12","nodes":[{"kind":"text","text":"with the first ripe figs;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.12","nodes":[{"kind":"text","text":"when shaken, they fall"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.12","nodes":[{"kind":"text","text":"into the mouth of the eater!"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.13","number":13,"nodes":[{"kind":"text","text":"Look at your troops —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.13","nodes":[{"kind":"text","text":"they are like your women!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.13","nodes":[{"kind":"text","text":"The gates of your land"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.13","nodes":[{"kind":"text","text":"are wide open to your enemies;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.13","nodes":[{"kind":"text","text":"fire consumes their bars."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.14","number":14,"nodes":[{"kind":"text","text":"Draw your water for the siege;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.14","nodes":[{"kind":"text","text":"strengthen your fortresses."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.14","nodes":[{"kind":"text","text":"Work the clay and tread the mortar;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.14","nodes":[{"kind":"text","text":"repair the brick kiln!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.15","number":15,"nodes":[{"kind":"text","text":"There the fire will devour you;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.15","nodes":[{"kind":"text","text":"the sword will cut you down"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.15","nodes":[{"kind":"text","text":"and consume you like a young locust."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.15","nodes":[{"kind":"text","text":"Make yourself many like the young locust;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.15","nodes":[{"kind":"text","text":"make yourself many like the swarming locust!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.16","number":16,"nodes":[{"kind":"text","text":"You have multiplied your merchants"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.16","nodes":[{"kind":"text","text":"more than the stars of the sky."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.16","nodes":[{"kind":"text","text":"The young locust strips the land"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.16","nodes":[{"kind":"text","text":"and flies away."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.17","number":17,"nodes":[{"kind":"text","text":"Your guards"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:17 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"princes"}]}]},{"kind":"text","text":" are like the swarming locust,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.17","nodes":[{"kind":"text","text":"and your scribes"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:17 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"marshals"}]}]},{"kind":"text","text":" like clouds of locusts"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.17","nodes":[{"kind":"text","text":"that settle on the walls on a cold day."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.17","nodes":[{"kind":"text","text":"When the sun rises, they fly away,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.17","nodes":[{"kind":"text","text":"and no one knows where."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.18","number":18,"nodes":[{"kind":"text","text":"O king of Assyria, your shepherds slumber;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.18","nodes":[{"kind":"text","text":"your officers sleep."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.18","nodes":[{"kind":"text","text":"Your people are scattered on the mountains"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.18","nodes":[{"kind":"text","text":"with no one to gather them."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.19","number":19,"nodes":[{"kind":"text","text":"There is no healing for your injury;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.19","nodes":[{"kind":"text","text":"your wound is severe."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.19","nodes":[{"kind":"text","text":"All who hear the news of you"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.19","nodes":[{"kind":"text","text":"applaud your downfall,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"nam.3.19","nodes":[{"kind":"text","text":"for who has not experienced"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"nam.3.19","nodes":[{"kind":"text","text":"your constant cruelty?"}]}]}]}]}
