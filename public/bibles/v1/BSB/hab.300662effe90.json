{"format":1,"book":"hab","name":"Habakkuk","chapters":[{"book":"hab","number":1,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Habakkuk’s First Complaint"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"hab.1.1","number":1,"nodes":[{"kind":"text","text":"This is the burden that Habakkuk the prophet received in a vision:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.2","number":2,"nodes":[{"kind":"text","text":"How long, O LORD, must I call for help"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.2","nodes":[{"kind":"text","text":"but You do not hear,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.2","nodes":[{"kind":"text","text":"or cry out to You, “Violence!”"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.2","nodes":[{"kind":"text","text":"but You do not save?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.3","number":3,"nodes":[{"kind":"text","text":"Why do You make me see iniquity?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.3","nodes":[{"kind":"text","text":"Why do You tolerate wrongdoing?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.3","nodes":[{"kind":"text","text":"Destruction and violence are before me."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.3","nodes":[{"kind":"text","text":"Strife is ongoing, and conflict abounds."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.4","number":4,"nodes":[{"kind":"text","text":"Therefore the law is paralyzed,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.4","nodes":[{"kind":"text","text":"and justice never goes forth."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.4","nodes":[{"kind":"text","text":"For the wicked hem in the righteous,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.4","nodes":[{"kind":"text","text":"so that justice is perverted."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The LORD’s Answer"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.5","number":5,"nodes":[{"kind":"text","text":"“Look at the nations and observe—"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.5","nodes":[{"kind":"text","text":"be utterly astounded!"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:5 "},{"kind":"text","text":"LXX "},{"kind":"em","children":[{"kind":"text","text":"Look, you scoffers, wonder and perish!"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.5","nodes":[{"kind":"text","text":"For I am doing a work in your days"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.5","nodes":[{"kind":"text","text":"that you would never believe"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.5","nodes":[{"kind":"text","text":"even if someone told you."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:5 "},{"kind":"text","text":"Cited in Acts 13:41"}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.6","number":6,"nodes":[{"kind":"text","text":"For behold, I am raising up the Chaldeans"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:6 "},{"kind":"text","text":"That is, the Babylonians"}]},{"kind":"text","text":" —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.6","nodes":[{"kind":"text","text":"that ruthless and impetuous nation"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.6","nodes":[{"kind":"text","text":"which marches through the breadth of the earth"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.6","nodes":[{"kind":"text","text":"to seize dwellings not their own."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.7","number":7,"nodes":[{"kind":"text","text":"They are dreaded and feared;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.7","nodes":[{"kind":"text","text":"from themselves they derive justice and sovereignty."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.8","number":8,"nodes":[{"kind":"text","text":"Their horses are swifter than leopards,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.8","nodes":[{"kind":"text","text":"fiercer than wolves of the night."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.8","nodes":[{"kind":"text","text":"Their horsemen charge ahead,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.8","nodes":[{"kind":"text","text":"and their cavalry comes from afar."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.8","nodes":[{"kind":"text","text":"They fly like a vulture,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.8","nodes":[{"kind":"text","text":"swooping down to devour."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.9","number":9,"nodes":[{"kind":"text","text":"All of them come bent on violence;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.9","nodes":[{"kind":"text","text":"their hordes advance like the east wind;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.9","nodes":[{"kind":"text","text":"they gather prisoners like sand."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.10","number":10,"nodes":[{"kind":"text","text":"They scoff at kings"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.10","nodes":[{"kind":"text","text":"and make rulers an object of scorn."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.10","nodes":[{"kind":"text","text":"They laugh at every fortress"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.10","nodes":[{"kind":"text","text":"and build up siege ramps to seize it."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.11","number":11,"nodes":[{"kind":"text","text":"Then they sweep by like the wind"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.11","nodes":[{"kind":"text","text":"and pass through."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.11","nodes":[{"kind":"text","text":"They are guilty;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.11","nodes":[{"kind":"text","text":"their own strength is their god.”"}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Habakkuk’s Second Complaint"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.12","number":12,"nodes":[{"kind":"text","text":"Are You not from everlasting,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"O LORD, my God, my Holy One?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"We will not die."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"O LORD, You have appointed them"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"to execute judgment;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"O Rock, You have established them"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.12","nodes":[{"kind":"text","text":"for correction."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.13","number":13,"nodes":[{"kind":"text","text":"Your eyes are too pure to look upon evil,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.13","nodes":[{"kind":"text","text":"and You cannot tolerate wrongdoing."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.13","nodes":[{"kind":"text","text":"So why do You tolerate the faithless?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.13","nodes":[{"kind":"text","text":"Why are You silent"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.13","nodes":[{"kind":"text","text":"while the wicked swallow up"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.13","nodes":[{"kind":"text","text":"those more righteous than themselves?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.14","number":14,"nodes":[{"kind":"text","text":"You have made men like the fish of the sea,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.14","nodes":[{"kind":"text","text":"like creeping things that have no ruler."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.15","number":15,"nodes":[{"kind":"text","text":"The foe pulls all of them up"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"1:15 "},{"kind":"text","text":"Literally "},{"kind":"em","children":[{"kind":"text","text":"He pulls all of them up"}]}]},{"kind":"text","text":" with a hook;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.15","nodes":[{"kind":"text","text":"he catches them in his dragnet,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.15","nodes":[{"kind":"text","text":"and gathers them in his fishing net;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.15","nodes":[{"kind":"text","text":"so he rejoices gladly."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.16","number":16,"nodes":[{"kind":"text","text":"Therefore he sacrifices to his dragnet"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.16","nodes":[{"kind":"text","text":"and burns incense to his fishing net,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.16","nodes":[{"kind":"text","text":"for by these things his portion is sumptuous"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.16","nodes":[{"kind":"text","text":"and his food is rich."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.1.17","number":17,"nodes":[{"kind":"text","text":"Will he, therefore, empty his net"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.1.17","nodes":[{"kind":"text","text":"and continue to slay nations without mercy?"}]}]}]},{"book":"hab","number":2,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"The LORD Answers Again"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.1","number":1,"nodes":[{"kind":"text","text":"I will stand at my guard post"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.1","nodes":[{"kind":"text","text":"and station myself on the ramparts."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.1","nodes":[{"kind":"text","text":"I will watch to see what He will say to me,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.1","nodes":[{"kind":"text","text":"and how I should answer when corrected."}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"hab.2.2","number":2,"nodes":[{"kind":"text","text":"Then the LORD answered me:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.2","nodes":[{"kind":"text","text":"“Write down this vision"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.2","nodes":[{"kind":"text","text":"and clearly inscribe it on tablets,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.2","nodes":[{"kind":"text","text":"so that a herald may run with it."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.3","number":3,"nodes":[{"kind":"text","text":"For the vision awaits an appointed time;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.3","nodes":[{"kind":"text","text":"it testifies of the end and does not lie."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.3","nodes":[{"kind":"text","text":"Though it lingers, wait for it,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.3","nodes":[{"kind":"text","text":"since it will surely come and will not delay."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:3 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"Though He lingers, wait for Him, since He will surely come and will not delay"}]},{"kind":"text","text":"; see also LXX; cited in Hebrews 10:37."}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.4","number":4,"nodes":[{"kind":"text","text":"Look at the proud one; his soul is not upright"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:4 "},{"kind":"text","text":"LXX "},{"kind":"em","children":[{"kind":"text","text":"If he should draw back, My soul has no pleasure in him"}]}]},{"kind":"text","text":" —"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.4","nodes":[{"kind":"text","text":"but the righteous will live by faith"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:4 "},{"kind":"text","text":"Or "},{"kind":"em","children":[{"kind":"text","text":"faithfulness"}]},{"kind":"text","text":"; cited in Romans 1:17, Galatians 3:11, and Hebrews 10:38"}]},{"kind":"text","text":" —"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.5","number":5,"nodes":[{"kind":"text","text":"and wealth"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:5 "},{"kind":"text","text":"DSS; MT "},{"kind":"em","children":[{"kind":"text","text":"wine"}]}]},{"kind":"text","text":" indeed betrays him."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.5","nodes":[{"kind":"text","text":"He is an arrogant man never at rest."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.5","nodes":[{"kind":"text","text":"He enlarges his appetite like Sheol,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.5","nodes":[{"kind":"text","text":"and like Death, he is never satisfied."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.5","nodes":[{"kind":"text","text":"He gathers all the nations to himself"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.5","nodes":[{"kind":"text","text":"and collects all the peoples as his own."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Woe to the Chaldeans"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.6","number":6,"nodes":[{"kind":"text","text":"Will not all of these take up a taunt against him,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.6","nodes":[{"kind":"text","text":"speaking with mockery and derision:"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.6","nodes":[{"kind":"text","text":"‘Woe to him who amasses what is not his"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.6","nodes":[{"kind":"text","text":"and makes himself rich with many loans!"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.6","nodes":[{"kind":"text","text":"How long will this go on?’"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.7","number":7,"nodes":[{"kind":"text","text":"Will not your creditors suddenly arise"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.7","nodes":[{"kind":"text","text":"and those who disturb you awaken?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.7","nodes":[{"kind":"text","text":"Then you will become their prey."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.8","number":8,"nodes":[{"kind":"text","text":"Because you have plundered many nations,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.8","nodes":[{"kind":"text","text":"the remnant of the people will plunder you—"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.8","nodes":[{"kind":"text","text":"because of your bloodshed against man"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.8","nodes":[{"kind":"text","text":"and your violence against the land, the city,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.8","nodes":[{"kind":"text","text":"and all their dwellers."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.9","number":9,"nodes":[{"kind":"text","text":"Woe to him who builds his house"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.9","nodes":[{"kind":"text","text":"by unjust gain,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.9","nodes":[{"kind":"text","text":"to place his nest on high"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.9","nodes":[{"kind":"text","text":"and escape the hand of disaster!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.10","number":10,"nodes":[{"kind":"text","text":"You have plotted shame for your house"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.10","nodes":[{"kind":"text","text":"by cutting off many peoples"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.10","nodes":[{"kind":"text","text":"and forfeiting your life."},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:10 "},{"kind":"text","text":"Literally "},{"kind":"em","children":[{"kind":"text","text":"sinning against your soul"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.11","number":11,"nodes":[{"kind":"text","text":"For the stones will cry out from the wall,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.11","nodes":[{"kind":"text","text":"and the rafters will echo it from the woodwork."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.12","number":12,"nodes":[{"kind":"text","text":"Woe to him who builds a city with bloodshed"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.12","nodes":[{"kind":"text","text":"and establishes a town by iniquity!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.13","number":13,"nodes":[{"kind":"text","text":"Is it not indeed from the LORD of Hosts"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.13","nodes":[{"kind":"text","text":"that the labor of the people only feeds the fire,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.13","nodes":[{"kind":"text","text":"and the nations weary themselves in vain?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.14","number":14,"nodes":[{"kind":"text","text":"For the earth will be filled"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.14","nodes":[{"kind":"text","text":"with the knowledge of the glory of the LORD"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.14","nodes":[{"kind":"text","text":"as the waters cover the sea."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.15","number":15,"nodes":[{"kind":"text","text":"Woe to him who gives drink to his neighbors,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.15","nodes":[{"kind":"text","text":"pouring it from the wineskin until they are drunk,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.15","nodes":[{"kind":"text","text":"in order to gaze at their nakedness!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.16","number":16,"nodes":[{"kind":"text","text":"You will be filled with shame instead of glory."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.16","nodes":[{"kind":"text","text":"You too must drink"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.16","nodes":[{"kind":"text","text":"and expose your uncircumcision!"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"2:16 "},{"kind":"text","text":"DSS, LXX, and Syriac "},{"kind":"em","children":[{"kind":"text","text":"and stagger"}]}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.16","nodes":[{"kind":"text","text":"The cup in the LORD’s right hand"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.16","nodes":[{"kind":"text","text":"will come around to you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.16","nodes":[{"kind":"text","text":"and utter disgrace will cover your glory."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.17","number":17,"nodes":[{"kind":"text","text":"For your violence against Lebanon will overwhelm you,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.17","nodes":[{"kind":"text","text":"and the destruction of animals will terrify you,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.17","nodes":[{"kind":"text","text":"because of your bloodshed against men"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.17","nodes":[{"kind":"text","text":"and your violence against the land, the city,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.17","nodes":[{"kind":"text","text":"and all their dwellers."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.18","number":18,"nodes":[{"kind":"text","text":"What use is an idol,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.18","nodes":[{"kind":"text","text":"that a craftsman should carve it —"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.18","nodes":[{"kind":"text","text":"or an image,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.18","nodes":[{"kind":"text","text":"a teacher of lies?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.18","nodes":[{"kind":"text","text":"For its maker trusts in his own creation;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.18","nodes":[{"kind":"text","text":"he makes idols that cannot speak."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.19","number":19,"nodes":[{"kind":"text","text":"Woe to him who says to wood, ‘Awake!’"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.19","nodes":[{"kind":"text","text":"or to silent stone, ‘Arise!’"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.19","nodes":[{"kind":"text","text":"Can it give guidance?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.19","nodes":[{"kind":"text","text":"Behold, it is overlaid with gold and silver,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.19","nodes":[{"kind":"text","text":"yet there is no breath in it at all.”"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.2.20","number":20,"nodes":[{"kind":"text","text":"But the LORD is in His holy temple;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.2.20","nodes":[{"kind":"text","text":"let all the earth be silent before Him."}]}]}]},{"book":"hab","number":3,"blocks":[{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Habakkuk’s Prayer"}]}]},{"kind":"paragraph","indent":0,"fragments":[{"id":"hab.3.1","number":1,"nodes":[{"kind":"text","text":"This is a prayer of Habakkuk the prophet, according to Shigionoth:"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:1 "},{"kind":"em","children":[{"kind":"text","text":"Shigionoth "}]},{"kind":"text","text":"is probably a musical term indicating the setting for the prayer."}]}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.2","number":2,"nodes":[{"kind":"text","text":"O LORD, I have heard the report of You;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.2","nodes":[{"kind":"text","text":"I stand in awe, O LORD, of Your deeds."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.2","nodes":[{"kind":"text","text":"Revive them in these years;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.2","nodes":[{"kind":"text","text":"make them known in these years."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.2","nodes":[{"kind":"text","text":"In Your wrath, remember mercy!"}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.3","number":3,"nodes":[{"kind":"text","text":"God came from Teman,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.3","nodes":[{"kind":"text","text":"and the Holy One from Mount Paran."}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"hab.3.3","nodes":[{"kind":"text","text":"Selah"},{"kind":"note","marker":"*","children":[{"kind":"text","text":"3:3 "},{"kind":"em","children":[{"kind":"text","text":"Selah "}]},{"kind":"text","text":"or "},{"kind":"em","children":[{"kind":"text","text":"Interlude "}]},{"kind":"text","text":"is probably a musical or literary term; also in verses 9 and 13."}]}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.3","nodes":[{"kind":"text","text":"His glory covered the heavens,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.3","nodes":[{"kind":"text","text":"and His praise filled the earth."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.4","number":4,"nodes":[{"kind":"text","text":"His radiance was like the sunlight;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.4","nodes":[{"kind":"text","text":"rays flashed from His hand,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.4","nodes":[{"kind":"text","text":"where His power is hidden."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.5","number":5,"nodes":[{"kind":"text","text":"Plague went before Him,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.5","nodes":[{"kind":"text","text":"and fever followed in His steps."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.6","number":6,"nodes":[{"kind":"text","text":"He stood and measured the earth;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.6","nodes":[{"kind":"text","text":"He looked and startled the nations;"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.6","nodes":[{"kind":"text","text":"the ancient mountains crumbled;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.6","nodes":[{"kind":"text","text":"the perpetual hills collapsed."}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.6","nodes":[{"kind":"text","text":"His ways are everlasting."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.7","number":7,"nodes":[{"kind":"text","text":"I saw the tents of Cushan in distress;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.7","nodes":[{"kind":"text","text":"the curtains of Midian were trembling."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.8","number":8,"nodes":[{"kind":"text","text":"Were You angry at the rivers, O LORD?"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.8","nodes":[{"kind":"text","text":"Was Your wrath against the streams?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.8","nodes":[{"kind":"text","text":"Did You rage against the sea"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.8","nodes":[{"kind":"text","text":"when You rode on Your horses,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.8","nodes":[{"kind":"text","text":"on Your chariots of salvation?"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.9","number":9,"nodes":[{"kind":"text","text":"You brandished Your bow;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.9","nodes":[{"kind":"text","text":"You called for many arrows."}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"hab.3.9","nodes":[{"kind":"text","text":"Selah"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.9","nodes":[{"kind":"text","text":"You split the earth with rivers."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.10","number":10,"nodes":[{"kind":"text","text":"The mountains saw You and quaked;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.10","nodes":[{"kind":"text","text":"torrents of water swept by."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.10","nodes":[{"kind":"text","text":"The deep roared with its voice"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.10","nodes":[{"kind":"text","text":"and lifted its hands on high."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.11","number":11,"nodes":[{"kind":"text","text":"Sun and moon stood still"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.11","nodes":[{"kind":"text","text":"in their places"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.11","nodes":[{"kind":"text","text":"at the flash of Your flying arrows,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.11","nodes":[{"kind":"text","text":"at the brightness of Your shining spear."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.12","number":12,"nodes":[{"kind":"text","text":"You marched across the earth with fury;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.12","nodes":[{"kind":"text","text":"You threshed the nations in wrath."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.13","number":13,"nodes":[{"kind":"text","text":"You went forth for the salvation of Your people,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.13","nodes":[{"kind":"text","text":"to save Your anointed."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.13","nodes":[{"kind":"text","text":"You crushed the head of the house of the wicked"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.13","nodes":[{"kind":"text","text":"and stripped him from head to toe."}]}]},{"kind":"poetry","indent":0,"fragments":[{"id":"hab.3.13","nodes":[{"kind":"text","text":"Selah"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.14","number":14,"nodes":[{"kind":"text","text":"With his own spear You pierced his head,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.14","nodes":[{"kind":"text","text":"when his warriors stormed out to scatter us,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.14","nodes":[{"kind":"text","text":"gloating as though ready"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.14","nodes":[{"kind":"text","text":"to secretly devour the weak."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.15","number":15,"nodes":[{"kind":"text","text":"You trampled the sea with Your horses,"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.15","nodes":[{"kind":"text","text":"churning the great waters."}]}]},{"kind":"break","indent":0,"fragments":[]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.16","number":16,"nodes":[{"kind":"text","text":"I heard and trembled within;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.16","nodes":[{"kind":"text","text":"my lips quivered at the sound."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.16","nodes":[{"kind":"text","text":"Decay entered my bones;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.16","nodes":[{"kind":"text","text":"I trembled where I stood."}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.16","nodes":[{"kind":"text","text":"Yet I must wait patiently for the day of distress"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.16","nodes":[{"kind":"text","text":"to come upon the people who invade us."}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"Habakkuk Rejoices"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.17","number":17,"nodes":[{"kind":"text","text":"Though the fig tree does not bud"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.17","nodes":[{"kind":"text","text":"and no fruit is on the vines,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.17","nodes":[{"kind":"text","text":"though the olive crop fails"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.17","nodes":[{"kind":"text","text":"and the fields produce no food,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.17","nodes":[{"kind":"text","text":"though the sheep are cut off from the fold"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.17","nodes":[{"kind":"text","text":"and no cattle are in the stalls,"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.18","number":18,"nodes":[{"kind":"text","text":"yet I will exult in the LORD;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.18","nodes":[{"kind":"text","text":"I will rejoice in the God of my salvation!"}]}]},{"kind":"poetry","indent":1,"fragments":[{"id":"hab.3.19","number":19,"nodes":[{"kind":"text","text":"GOD the Lord is my strength;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.19","nodes":[{"kind":"text","text":"He makes my feet like those of a deer;"}]}]},{"kind":"poetry","indent":2,"fragments":[{"id":"hab.3.19","nodes":[{"kind":"text","text":"He makes me walk upon the heights!"}]}]},{"kind":"heading","indent":0,"fragments":[{"id":"","nodes":[{"kind":"text","text":"For the choirmaster. With stringed instruments."}]}]}]}]}
