{
	"name": "instant-bible",
	"version": "0.1.0",
	"license": "MIT-0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0",
		"lint": "eslint .",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:visual": "playwright test visual",
		"test:visual:update": "playwright test visual --update-snapshots",
		"bible:update-bsb": "tsx scripts/update-bsb.ts",
		"bible:validate": "tsx scripts/validate-bsb.ts",
		"bundle:check": "node scripts/check-bundle.mjs",
		"icons:generate": "node scripts/generate-icons.mjs",
		"check": "npm run lint && npm run typecheck && npm run bible:validate && npm run test && npm run build && npm run bundle:check && npm run test:e2e"
	},
	"dependencies": {
		"@gracious.tech/fetch-client": "^2.4.0",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.4",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.12.0",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"linkedom": "^0.18.13",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.3",
		"vue-tsc": "^3.3.12"
	}
}
